model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-ZA
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["dim_customer","dim_date","dim_geography","dim_product","dim_seller","fct_order_items","fct_orders","_Measures"]

annotation PBI_ProTooling = ["DevMode"]

ref table dim_customer
ref table dim_date
ref table dim_geography
ref table dim_product
ref table dim_seller
ref table fct_order_items
ref table fct_orders
ref table _Measures

ref cultureInfo en-US

