[sqlfluff]
dialect = tsql
# The dbt templater needs a live warehouse connection on Fabric (dbt-fabric opens
# one while compiling), so CI uses the jinja templater with dbt builtins instead.
templater = jinja
large_file_skip_byte_limit = 0

[sqlfluff:templater:jinja]
apply_dbt_builtins = True
load_macros_from_path = dbt/olist_analytics/macros
# Stubs for package macros (dbt_utils) that the jinja templater can't resolve.
library_path = .sqlfluff_libs

[sqlfluff:rules:capitalisation.keywords]
capitalisation_policy = upper
# dim_date's numbers column is called n; the tsql parser reads it as a keyword
# inside DATEADD. Fabric's default collation is case-sensitive, so it must stay n.
ignore_words = n

[sqlfluff:rules:capitalisation.functions]
extended_capitalisation_policy = upper

[sqlfluff:rules:capitalisation.types]
extended_capitalisation_policy = upper
